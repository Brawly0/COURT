# Machine-local tool config: points at a localhost port that exists only here.
game/.mcp.json
game/.claude/
game/.vscode/

# Third-party art packs. Held out of a PUBLIC repo deliberately - Asset Store
# licences generally forbid redistribution, and a public repo is redistribution.
# Nothing in the greybox uses them. Remove these lines if the licence allows it.
game/Assets/Art/
game/Assets/Art.meta
